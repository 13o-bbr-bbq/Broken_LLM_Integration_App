# Auth (JWT).
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MySQL.
DB_USERNAME=root
DB_PASSWORD=root
DB_HOST=db
DB_NAME=broken_chatbot

# LLM Provider.
#LLM_PROVIDER=ollama
#LLM_PROVIDER=bedrock
#LLM_PROVIDER=gemini
LLM_PROVIDER=openai

# OpenAI GPT.
OPENAI_API_KEY=your_openai_api_key
#OPENAI_BASE_URL=https://your-custom-endpoint/v1
OPENAI_MODEL_NAME=your_openai_model_name
OPENAI_MAX_TOKENS=256
OPENAI_TEMPERATURE=0.9
OPENAI_VERBOSE=true

# Ollama.
OLLAMA_BASE_URL=http://your-ollama-endpoint:11434
OLLAMA_MODEL_NAME=your_local_llm_name
OLLAMA_VERBOSE=true

# Amazon Bedrock (IAM auth).
BEDROCK_REGION_NAME=your_bedrock_region
BEDROCK_MODEL_ID=your_bedrock_model_id
BEDROCK_AWS_ACCESS_KEY_ID=your_aws_access_key_id
BEDROCK_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Required only for temporary credentials (STS/SSO/AssumeRole)
#BEDROCK_AWS_SESSION_TOKEN=your_aws_session_token
BEDROCK_MAX_TOKENS=256
BEDROCK_TEMPERATURE=0.9
BEDROCK_VERBOSE=true

# Google Gemini.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=your_gemini_model_name
GEMINI_MAX_TOKENS=256
GEMINI_TEMPERATURE=0.9
GEMINI_VERBOSE=true

# DeepKeep
DK_API_URL=your_deepkeep_api_url
DK_FIREWALL_ID=your_deepkeep_fw_id
DK_TOKEN=your_deepkeep_api_key
